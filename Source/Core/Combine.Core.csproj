<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.0</Version>
        <PackageId>Combine.Core</PackageId>

        <Authors>Rayscale</Authors>
        <Company>Rayscale</Company>
        <Description>Core primitives, abstractions, and foundational utilities.</Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/dotm4x/combine</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dotm4x/combine</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageTags>combine;core;primitives;abstractions</PackageTags>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
</Project>
