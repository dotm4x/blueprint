<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.0</Version>
        <PackageId>Combine.Common</PackageId>

        <Authors>Rayscale</Authors>
        <Company>Rayscale</Company>
        <Description>Common primitives, abstractions, and foundational utilities.</Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/dotm4x/combine</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dotm4x/combine</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageTags>combine;common;primitives;abstractions</PackageTags>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Numerics\Combine.Numerics.csproj" />
    </ItemGroup>
</Project>
